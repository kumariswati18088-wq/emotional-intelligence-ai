# --- Server ---
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change_this_to_a_long_random_string

# --- Admin (server-side only, never shipped to the client bundle) ---
# The frontend never stores this value. When the user types this exact
# string into the chat box, the client calls POST /api/admin/verify with
# whatever they typed, and this is what the server compares it against.
ADMIN_SECRET_PASSWORD=Rounak@2523

# --- AI provider keys ---
HUME_API_KEY=your_hume_api_key
GEMINI_API_KEY=your_gemini_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
HEYGEN_API_KEY=your_heygen_api_key

# --- Avatar IDs (HeyGen) ---
GIRL1_AVATAR_ID=your_girl1_avatar_id
GIRL2_AVATAR_ID=your_girl2_avatar_id
BOY1_AVATAR_ID=your_boy1_avatar_id
BOY2_AVATAR_ID=your_boy2_avatar_id

# --- Voice IDs (ElevenLabs) ---
VOICE_ADAM=your_adam_voice_id
VOICE_GIGI=your_gigi_voice_id
VOICE_MATILDA=your_matilda_voice_id
